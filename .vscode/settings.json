{
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json5]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "biome.enabled": true,
  "cSpell.words": [
    "Acro",
    "Antalpha",
    "aurelion",
    "Cascader",
    "casdoor",
    "codoors",
    "crowdinrc",
    "droplist",
    "Fintech",
    "Hashrate",
    "iconbox",
    "languagedetector",
    "Lngs",
    "metalpha",
    "mkdirs",
    "nuqs",
    "rgba",
    "shadcn",
    "sonner",
    "tanstack",
    "tinyexec",
    "TTBTC",
    "turbopack",
    "unrs",
    "vaul",
    "webui",
    "ZHTW"
  ],
  "css.customData": [
    ".vscode/tailwind.json"
  ],
  "css.format.enable": false,
  "editor.codeActionsOnSave": {
    "quickfix.biome.correctness.noUnusedImports": "never",
    "quickfix.biome.correctness.noUnusedVariables": "never",
    "source.action.useSortedAttributes.biome": "explicit",
    "source.action.useSortedKeys.biome": "explicit",
    "source.action.useSortedProperties.biome": "explicit",
    "source.addMissingImports": "explicit",
    "source.fixAll.biome": "explicit",
    "source.fixAll.eslint": "never",
    "source.fixAll.ts": "never",
    "source.organizeImports": "never",
    "source.organizeImports.biome": "explicit"
  },
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "files.autoSaveWhenNoErrors": true,
  "liveServer.settings.port": 3000,
  "liveServer.settings.root": "apps/risk/out",
  "tailwindCSS.experimental.configFile": "./packages/ui/src/styles/globals.css",
  "todo-tree.tree.showBadges": true,
  "workbench.editorAssociations": {
    "*.md": "default"
  },
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ab307e",
    "activityBar.background": "#ab307e",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#25320e",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#ab307e",
    "statusBar.background": "#832561",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#ab307e",
    "statusBarItem.remoteBackground": "#832561",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#832561",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#83256199",
    "titleBar.inactiveForeground": "#e7e7e799"
  },
  "peacock.color": "#832561",
  "git.ignoreLimitWarning": true
}
