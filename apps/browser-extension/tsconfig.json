  "compilerOptions": {
    "types": ["unplugin-turbo-console/client"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@memory-prosthetic/ui": ["../../packages/ui/src/index.ts"],
