{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Prosthetic",
  "version": "0.1.3",
  "identifier": "com.aa00930.memory-prosthetic",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Memory Prosthetic",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      },
      {
        "label": "search",
        "title": "Search",
        "url": "/search",
        "width": 680,
        "height": 480,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true,
        "shadow": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/**/*"]
  }
}
