{
  "name": "memory-prosthetic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "bun run --filter '@memory-prosthetic/desktop' tauri dev",
    "dev:browser-extension": "bun run --filter '@memory-prosthetic/browser-extension' dev",
    "build": "bun run --filter '@memory-prosthetic/desktop' build && bun run --filter '@memory-prosthetic/browser-extension' build",
    "format": "biome format --write"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.0-beta.61",
    "@ai-sdk/google": "^3.0.0-beta.88",
    "@ai-sdk/openai": "^3.0.0-beta.111",
    "@ai-sdk/react": "^3.0.0-beta.169",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.142.8",
    "@tanstack/react-router-devtools": "^1.142.8",
    "ai": "^6.0.0-beta.166",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^16.2.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "unplugin-turbo-console": "^2.3.0",
    "vite": "^7.3.0",
    "vite-imagetools": "^9.0.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs,jsx,tsx,json,jsonc,css}": [
      "biome format --write"
    ]
  }
}
