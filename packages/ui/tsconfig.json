{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@memory-prosthetic/ui/components": ["./src/components"],
      "@memory-prosthetic/ui/components/*": ["./src/components/*"],
      "@memory-prosthetic/ui/utils/tw": ["./src/utils/tw"],
      "@memory-prosthetic/ui/hooks": ["./src/hooks"],
      "@memory-prosthetic/ui/hooks/*": ["./src/hooks/*"],
      "@memory-prosthetic/ui/lib": ["./src/lib"],
      "@memory-prosthetic/ui/lib/*": ["./src/lib/*"]
    },
    // Ignore type errors in shadcn/ui generated components (React 19 ref type compatibility)
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "src/components/ui/**/*"]
}
