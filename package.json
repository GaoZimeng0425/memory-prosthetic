{
  "name": "memory-prosthetic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:desktop": "bun run --filter '@memory-prosthetic/desktop' tauri build",
    "dev:desktop": "bun run --filter '@memory-prosthetic/desktop' tauri dev",
    "dev:browser-extension": "cd apps/browser-extension && bun run dev",
    "build:browser-extension": "cd apps/browser-extension && bun run zip",
    "build": "bun run ./scripts/build.ts",
    "format": "biome format --write"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0-alpha.9",
    "@slack/web-api": "^7.13.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-router": "^1.151.6",
    "@tanstack/react-router-devtools": "^1.151.6",
    "@tauri-apps/api": "^2.9.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "code-inspector-plugin": "^1.3.6",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "execa": "^9.6.1",
    "leven": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-use": "^17.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.151.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^16.2.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "unplugin-turbo-console": "^2.3.0",
    "vite": "^7.3.1",
    "vite-imagetools": "^9.0.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "lint-staged": {
    "**/*.{js,ts,mjs,jsx,tsx,json,jsonc,css}": [
      "biome format --write"
    ]
  }
}
